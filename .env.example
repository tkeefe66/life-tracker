# Required
ANTHROPIC_API_KEY=sk-ant-...
APP_PASSWORD=choose-a-strong-password

# Optional — Telegram send-only weekly push
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Postgres (Railway sets this); blank = local SQLite
DATABASE_URL=

# Google OAuth2 (Calendar + Gmail; token must carry BOTH scopes — run scripts/calendar_auth.py)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional tuning
TIMEZONE=America/Denver
GMAIL_SCAN_INTERVAL_HOURS=4
GMAIL_SCAN_LOOKBACK_DAYS=7
CALENDAR_SCAN_HOUR=6
WEEKLY_PUSH_HOUR=9
