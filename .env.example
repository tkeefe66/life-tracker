# Anthropic (for AI focus summarization)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Webhook (Railway production — leave blank for local polling mode)
WEBHOOK_URL=https://your-app.railway.app

# Schedule (24-hour format, your local timezone)
DAILY_PROMPT_HOUR=18
DAILY_PROMPT_MINUTE=0
WEEKLY_SUMMARY_HOUR=17
HABIT_REMINDER_HOUR=7
HABIT_REMINDER_MINUTE=0
TIMEZONE=America/Denver

# Google Sheets
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Service account — use ONE of these:
# Local dev: path to downloaded JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Railway production: paste the entire JSON contents as a single line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Database
# Railway: set automatically when you add the PostgreSQL addon
# Local dev: set this to your PostgreSQL connection string, OR leave blank to use SQLite
DATABASE_URL=postgresql://user:password@host:port/dbname

# Spreadsheet ID for one-time Life Log backfill (the user's existing memory sheet)
LIFE_LOG_IMPORT_SHEET_ID=
